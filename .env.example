# Copie este archivo a .env (no se versiona). No ponga secretos reales aquí.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://scrum:scrum_dev_password@localhost:5432/scrum_dev
TEST_DATABASE_URL=postgresql://scrum:scrum_test_password@localhost:5433/scrum_test

# Cadena aleatoria larga (mínimo 32 caracteres)
SESSION_SECRET=cambie-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas

# Orígenes permitidos por CORS (vacío = mismo origen; recomendado)
CORS_ALLOWED_ORIGINS=

# IA: fake (solo desarrollo y pruebas; prohibido en producción) u openai-compatible (Groq)
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=1500
# Solo para modelos con razonamiento (p. ej. openai/gpt-oss-* en Groq): low | medium | high. Vacío = no se envía.
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.2

# Límites de uso de IA (calibrar en el piloto; el global debe quedar por debajo del cupo del proveedor)
AI_USER_RATE_PER_MINUTE=10
AI_DAILY_TOKEN_BUDGET_GLOBAL=170000
AI_DAILY_TOKEN_BUDGET_PER_PROJECT=40000
